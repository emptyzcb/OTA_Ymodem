--cpu Cortex-M3
"zet6_bt\startup_stm32f103xe.o"
"zet6_bt\main.o"
"zet6_bt\gpio.o"
"zet6_bt\dma.o"
"zet6_bt\usart.o"
"zet6_bt\stm32f1xx_it.o"
"zet6_bt\stm32f1xx_hal_msp.o"
"zet6_bt\stm32f1xx_hal_gpio_ex.o"
"zet6_bt\stm32f1xx_hal_uart.o"
"zet6_bt\stm32f1xx_hal.o"
"zet6_bt\stm32f1xx_hal_rcc.o"
"zet6_bt\stm32f1xx_hal_rcc_ex.o"
"zet6_bt\stm32f1xx_hal_gpio.o"
"zet6_bt\stm32f1xx_hal_dma.o"
"zet6_bt\stm32f1xx_hal_cortex.o"
"zet6_bt\stm32f1xx_hal_pwr.o"
"zet6_bt\stm32f1xx_hal_flash.o"
